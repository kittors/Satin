  "design": {
    "do": [
      "外面的圆角比里面的大：卡片 12、卡片里的按钮 8。",
      "要分组时先加留白，不够再用明度差，最后才画线。"
    ],
    "dont": [
      {
        "text": "到处画分割线、左侧竖条。",
        "rule": "no-decorative-divider"
      },
      {
        "text": "卡片里再套带边框的卡片。",
        "rule": "card-nesting"
      }
    ]
