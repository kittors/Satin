  "design": {
    "do": [
      "组件之间写语义令牌（--sn-gap-*、--sn-pad-*），不写数字。",
      "组和组之间至少是组内的两倍（8 和 16、12 和 24）。",
      "标题离下面的内容比离上面的近。"
    ],
    "dont": [
      {
        "text": "写刻度外的值（13px、18px）又不写原因（/* sp-ok: … */）。",
        "rule": "spacing-scale"
      },
      {
        "text": "到处画分隔线代替留白。",
        "rule": "no-decorative-divider"
      }
    ]
  }
