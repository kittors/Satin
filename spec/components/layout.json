  "design": {
    "do": [
      "阅读型页面最大宽 960 居中；表单最大宽 640，720 起标签在左、更窄时在上。",
      "卡片网格不写死列数：最小卡宽加 auto-fill。",
      "检查器 320 宽，1280 起和主区并排，更窄时变成盖在上面的抽屉。"
    ],
    "dont": [
      {
        "text": "按钮文字挤得换行、页面横向滚动。",
        "rule": "button-wrap"
      },
      {
        "text": "窄屏时浮层、工具条盖住内容。",
        "rule": "no-overlap"
      },
      {
        "text": "跨断点时加过渡动画。",
        "rule": "motion-props"
      }
    ]
