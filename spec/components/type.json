      "desc": "长文阅读（可选）",
      "default": "\"Songti SC\"…",
      "token": true
    },
    {
      "name": "--sn-font-scale",
      "desc": "整体字号倍数（设置里的\"字号\"）",
      "default": "1",
      "token": true
    }
