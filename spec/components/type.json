  "design": {
    "do": [
      "标题、正文、说明各选一级，色调用 label 四级灰。",
      "计数、价格、时间、表格里的数字用等宽数字。",
      "文字被截断时悬停显示全文；没被截断就不显示提示。"
    ],
    "dont": [
      {
        "text": "随手写 font-size、font-weight: 700。",
        "rule": "font-weight"
      },
      {
        "text": "标题上方加英文小眉题。",
        "rule": "no-eyebrow"
      },
      {
        "text": "写\"极致\"\"赋能\"这类营销词。",
        "rule": "marketing-copy"
      }
    ]
  }
