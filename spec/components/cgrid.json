        "satin-ui/canvas-grid"
      ]
    ]
  },
  "example": {
    "0": {
      "js": "import { mountCanvasGrid } from \"satin-ui/canvas-grid\";\nimport \"satin-ui/css/grid.css\";\nimport \"satin-ui/css/data.css\";\n\n// 整张表画在一块画布上：百万行照样流畅；交互和 DOM 版一致\nmountCanvasGrid(document.querySelector(\".sn-grid.cgrid\"), { rows: 1000000 });"
    }
  },
